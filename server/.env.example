# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<DIRECT_DB_HOST>:5432/postgres"

# PostgreSQL TLS options
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM content, if your server requires a custom CA cert
# PG_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# App runtime
JWT_SECRET="replace-with-a-random-32-plus-char-secret"
PORT=3000
NODE_ENV="development"
